{
  "manifest_version": 3,
  "name": "Nexus",
  "version": "1.1.1",
  "description": "Right-click selected text or a link to scan it with the Nexus phishing detection service.",
  "action": {
    "default_title": "Nexus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/nexus-logo.png",
      "32": "assets/nexus-logo.png",
      "48": "assets/nexus-logo.png",
      "128": "assets/nexus-logo.png"
    }
  },
  "icons": {
    "16": "assets/nexus-logo.png",
    "48": "assets/nexus-logo.png",
    "128": "assets/nexus-logo.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["contextMenus"],
  "host_permissions": ["https://nexus-phishing-api.onrender.com/*"]
}
